<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="jjadanExamen.Views.vRegistro">
    <ContentPage.Content>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label x:Name="lblUsuario" />
            <Label Text="Registro"
                   HorizontalOptions="Center" />

                <Grid>        
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Label 
                        Text="Nombre" 
                        Grid.Row="0" 
                        Grid.Column="0" />
                    <Label 
                        Text="Apellido" 
                        Grid.Row="0" 
                        Grid.Column="1" />
                    <Label 
                        Text="Edad" 
                        Grid.Row="0" 
                        Grid.Column="2" />

                    <Entry x:Name="txtNombre"
                           Placeholder="Ingresar nombre"
                           Grid.Row="1" 
                           Grid.Column="0" />
                    <Entry x:Name="txtApellido"
                           Placeholder="Ingresar apellido"
                           Grid.Row="1" 
                           Grid.Column="1" />
                    <Entry x:Name="txtEdad"
                           Placeholder="Edad"
                           Text="16"
                           Keyboard="Numeric"
                           Grid.Row="1" 
                           Grid.Column="2" />
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Label 
                        Text="Fecha de inicio" 
                        Grid.Row="0" 
                        Grid.Column="0" 
                        VerticalOptions="Center" />
                    <DatePicker x:Name="dpFechaInicio" 
                                Grid.Row="0" Grid.Column="1" />

                    <Label 
                        Text="Plan" 
                        Grid.Row="1" 
                        Grid.Column="0" 
                        VerticalOptions="Center" />
                    <Picker x:Name="pkPlan"
                            Title="Seleccione un plan"
                            Grid.Row="1" 
                            Grid.Column="1">
                        
                        <Picker.Items>
                                <x:String>Musculación</x:String>
                                <x:String>Cardio</x:String>
                                <x:String>Crossfit</x:String>
                                <x:String>Full</x:String>
                        </Picker.Items>
                    </Picker>
                    

                    <Label Text="Casillero" Grid.Row="2" Grid.Column="0" VerticalOptions="Center" />
                    <Switch x:Name="swCasillero"
                            IsToggled="False"
                            Grid.Row="2" Grid.Column="1"
                            HorizontalOptions="Start" />

                    <Label Text="Monto inicial" Grid.Row="3" Grid.Column="0" VerticalOptions="Center" />
                    <Entry x:Name="txtMontoInicial"
                           Placeholder="Entre 120 y 600"
                           Keyboard="Numeric"
                           Grid.Row="3" Grid.Column="1" />

                    <Button Text="Calcular pago mensual"
                            Clicked="OnCalcularClicked"
                            Grid.Row="4" Grid.Column="0" />
                    <Entry x:Name="txtPagoMensual"
                           Placeholder="Pago mensual"
                           IsReadOnly="True"
                           Grid.Row="4" Grid.Column="1" />
                </Grid>

                <Button x:Name="btnVerResumen"
                        Text="Ver Resumen"
                        Clicked="OnVerResumenClicked" />
            </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>
